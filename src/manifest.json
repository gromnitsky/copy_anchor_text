{
    "manifest_version": 3,
    "name": "copy_anchor_text",
    "version": "1.0.0",
    "description": "Copy link text or image title/alt via a context menu.",
    "icons": {
        "128": "icons/128.png"
    },
    "permissions": [
        "contextMenus",
        "clipboardWrite",
        "offscreen"
    ],
    "background": {
        "service_worker": "service_worker.js",
        "type": "module"
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["content_script.js"]
    }]
}
